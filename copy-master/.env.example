# Copy to .env.local and fill in. .env.local is gitignored.
#
# None of the secrets below are NEXT_PUBLIC_, so they stay on the server. The
# service role key bypasses Row Level Security entirely — it is read only
# inside the /api/events route handler and must never reach the browser.
#
# Capture is optional. With these unset the app still runs; it simply stops
# recording and nothing in the UI changes.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Store the raw pasted copy alongside the derived metrics. BOTH must be true
# before any text is written: the browser only sends a sample when the public
# one is on, and the server drops it unless the private one is too. Off by
# default, because this column holds whatever the user wrote.
CAPTURE_TEXT_SAMPLES=false
NEXT_PUBLIC_CAPTURE_TEXT_SAMPLES=false

# Client-side kill switch. Set to false to stop the browser sending anything.
NEXT_PUBLIC_CAPTURE_ENABLED=true

# Claude, for the "Fix with Claude" button. Read only inside the /api/fix
# route handler, which runs on the server. Never prefix with NEXT_PUBLIC_.
# Without it the button hides itself and the rest of the app is unaffected.
ANTHROPIC_API_KEY=

# Defaults to claude-opus-5-5. Override to trade quality for speed and cost.
# ANTHROPIC_MODEL=claude-sonnet-5-5
